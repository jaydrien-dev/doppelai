{
  "id": "google-calendar",
  "name": "Google Calendar",
  "description": "See today's schedule, check upcoming meetings, and search your Google Calendar.",
  "version": "0.1.0",
  "author": "Doppel",
  "icon": "calendar",
  "category": "productivity",
  "type": "api",
  "builtin": true,
  "permissions": ["calendar"],
  "config": [],
  "auth": {
    "provider": "google",
    "clientId": "DOPPEL_GOOGLE_CLIENT_ID",
    "authUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "openid",
      "email"
    ]
  },
  "tools": [
    {
      "name": "gcal_today",
      "description": "Get today's events from Google Calendar. Returns title, time, location, and attendees.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "gcal_upcoming",
      "description": "Get upcoming events from the next N hours (default 4).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hours": { "type": "number", "description": "How many hours ahead. Default: 4." }
        }
      }
    },
    {
      "name": "gcal_search",
      "description": "Search Google Calendar events by keyword across the past and next 30 days.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "Keyword to search for." },
          "days": { "type": "number", "description": "Days forward and backward. Default: 30." }
        }
      }
    }
  ]
}
